FROM --platform=$BUILDPLATFORM golang:1.26.3-bookworm AS build
ARG TARGETOS
ARG TARGETARCH
COPY --from=wisp-source / /src/wisp/
COPY scripts/build-wisp.sh /src/chen/scripts/build-wisp.sh
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    GOOS=${TARGETOS} GOARCH=${TARGETARCH} WISP_SOURCE=/src/wisp WISP_BIN=/out/wisp /src/chen/scripts/build-wisp.sh
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 chen && useradd --uid 10001 --gid chen --create-home chen \
    && mkdir -p /opt/chen/data && chown -R chen:chen /opt/chen
COPY --from=build /out/wisp /usr/local/bin/wisp
USER 10001:10001
WORKDIR /opt/chen
ENV EXECUTE_PROGRAM="" COMPONENT_NAME=chen WORK_DIR=/opt/chen
EXPOSE 9090
ENTRYPOINT ["/usr/local/bin/wisp"]
