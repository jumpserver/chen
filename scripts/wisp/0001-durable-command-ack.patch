-func (u *UploaderService) UploadCommand(cmd *model.Command) {
-	u.commandChan <- cmd
+// Chen keeps a durable outbox until this call succeeds. A memory-queue ACK
+// loses the last command when Wisp stops before its batch timer fires.
+func (u *UploaderService) UploadCommand(cmd *model.Command) error {
+	commands := []*model.Command{cmd}
+	backend := u.getCommandBackend()
+	err := backend.BulkSave(commands)
+	if err != nil && backend.TypeName() != "server" {
+		err = u.apiClient.PushSessionCommand(commands)
+	}
+	if err != nil {
+		return fmt.Errorf("command persistence failed: %w", err)
+	}
+	if cmd.RiskLevel >= model.WarningLevel && cmd.RiskLevel <= model.ReviewReject {
+		if err := u.apiClient.NotifyCommand(commands); err != nil {
+			// An uncertain ACK may cause a repeated audit on retry. Preserve the
+			// caller's durable record until both required operations succeed.
+			return fmt.Errorf("command notification failed: %w", err)
+		}
+	}
+	return nil
 }
 
